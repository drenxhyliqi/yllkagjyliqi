# development | test | production
ENVIRONMENT=development

# SQLAlchemy URL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/yllka

# Origin of the Next.js site, allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# IANA zone for Kosovo (there is no Europe/Pristina)
BUSINESS_TIMEZONE=Europe/Belgrade

# How many days an admin stays signed in on a device
SESSION_DAYS=14

# Error monitoring (sentry.io); leave empty to turn off
SENTRY_DSN=

# Photos: "local" (disk, development) or "cloudinary" (production)
IMAGE_PROVIDER=local
MEDIA_ROOT=media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yllka

# The public website, for links in emails
SITE_URL=http://localhost:3000

# Emails through Resend (resend.com); without a key, emails are only logged
RESEND_API_KEY=
EMAIL_FROM=Yllka <termine@example.com>
# Where new-request emails go (comma-separated); default: the admin's email
NOTIFY_EMAIL=
